<mujoco model="two_joint_pick_place">
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81" impratio="10"/>

  <default>
    <geom friction="2 0.1 0.1" condim="4"/>
    <joint damping="10"/>
  </default>

  <worldbody>

    <!-- Ground -->
    <geom type="plane" size="5 5 0.1" rgba="0.9 0.9 0.9 1"/>

    <!-- Target drop zone -->
    <geom name="target"
          type="cylinder"
          size="0.08 0.005"
          pos="0.6 0 0.005"
          rgba="0 1 0 0.3"
          contype="0"
          conaffinity="0"/>

    <!-- Arm Base -->
    <body name="base" pos="0 0 0.1">

      <joint name="shoulder_yaw"
             type="hinge"
             axis="0 0 1"
             range="-90 90"/>

      <joint name="shoulder"
             type="hinge"
             axis="0 1 0"
             range="-90 90"/>

      <geom type="capsule"
            fromto="0 0 0 0.3 0 0"
            size="0.03"
            mass="1"/>

      <!-- Link 2 -->
      <body name="link2" pos="0.3 0 0">

        <joint name="elbow"
               type="hinge"
               axis="0 1 0"
               range="-120 120"/>

        <geom type="capsule"
              fromto="0 0 0 0.25 0 0"
              size="0.025"
              mass="1"/>

        <!-- Gripper -->
        <body name="gripper" pos="0.25 0 0">

          <body pos="0 0.03 0">
            <joint name="fingerL"
                   type="slide"
                   axis="0 -1 0"
                   range="0 0.06"/>
            <geom type="box"
                  pos="0.03 0 0"
                  size="0.03 0.005 0.02"
                  mass="0.02"
                  friction="0.5 1 1"
                  condim="4"/>
          </body>

          <body pos="0 -0.03 0">
            <joint name="fingerR"
                   type="slide"
                   axis="0 1 0"
                   range="0 0.06"/>
            <geom type="box"
                  pos="0.03 0 0"
                  size="0.03 0.005 0.02"
                  mass="0.02"
                  friction="0.5 1 1"
                  condim="4"/>
          </body>

        </body>
      </body>
    </body>

    <body name="box" pos="0 0 0">
      <freejoint name="box_joint"/>
      <geom type="box"
            size="0.015 0.015 0.015"
            mass="0.02"
            rgba="0.9 0.2 0.2 1"
            friction="1.5 0.5 0.1"/>
    </body>
    <body name="box2" pos="0 0 0">
      <freejoint name="box2_joint"/>
      <geom type="box"
            size="0.015 0.015 0.015"
            mass="0.02"
            rgba="0.2 0.4 0.9 1"
            friction="1.5 0.5 0.1"/>
    </body>

  </worldbody>

  <tendon>
    <fixed name="gripper_tendon">
      <joint joint="fingerL" coef="1"/>
      <joint joint="fingerR" coef="1"/>
    </fixed>
  </tendon>

  <actuator>
    <position name="Shoulder Servo"
              joint="shoulder"
              kp="30"
              ctrlrange="-3.14 3.14"
              ctrllimited="true"/>

    <position name="Elbow Servo"
              joint="elbow"
              kp="50"
              ctrlrange="-2.094 2.094"
              ctrllimited="true"/>

    <position name="Gripper"
              tendon="gripper_tendon"
              kp="50"
              ctrlrange="0 0.05"
              ctrllimited="true"/>

    <position name="Shoulder Yaw Servo"
              joint="shoulder_yaw"
              kp="30"
              ctrlrange="-3.14 3.14"
              ctrllimited="true"/>
  </actuator>

</mujoco>